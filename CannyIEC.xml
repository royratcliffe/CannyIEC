      <pou name="REPSILONEQ" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inputVars>
            <variable name="rLHS">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> nominal left-hand side </xhtml>
              </documentation>
            </variable>
            <variable name="rRHS">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> nominal right-hand side </xhtml>
              </documentation>
            </variable>
            <variable name="rEpsilon">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="REAL#1E-06" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> allowable difference </xhtml>
              </documentation>
            </variable>
          </inputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Error band is inclusive of the epsilon value.
Less than or equal to is close enough, rather than strict equality. *)
REPSILONEQ := ABS(rLHS - rRHS) &lt;= rEpsilon;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>07425b46-a220-4c35-97df-8434c6921314</ObjectId>
          </data>
        </addData>
      </pou>
