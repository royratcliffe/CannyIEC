    <pous>
      <pou name="AsymmetricDebounce" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> raw input signal from a sensor or switch </xhtml>
              </documentation>
            </variable>
            <variable name="tPresetRise">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#50ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> preset time for rising edge debounce </xhtml>
              </documentation>
            </variable>
            <variable name="tPresetFall">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#50ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> preset time for falling edge debounce </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> debounced "input" signal </xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="fbDeb">
              <type>
                <derived name="WAS" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> WAS instance for handling the debounce timing </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Only accept a state change after the raw input remains stable for its
   configured debounce time. *)
fbDeb(IN := IN);
IF fbDeb.ET &gt;= SEL(IN, tPresetFall, tPresetRise) THEN
	Q := IN;
END_IF;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>e3413540-c160-4c6a-8aac-450a7c7366ce</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="DIF" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <BOOL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="xWas">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Q    := IN &lt;&gt; xWas;
xWas := IN;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>20492c08-5783-4af7-ba50-d4cf1b4f7d08</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FirstCycle" pouType="functionBlock">
        <interface>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> TRUE during the first cycle of the program run </xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="X">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Has executed at least once during the program run </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Track the first cycle of the program run. Q will be TRUE only during
   the first cycle, and X will be set to TRUE afterwards. *)
Q := NOT X;
X := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a4305850-d3ec-4e8e-9e7d-8fff93ceead4</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="PT1" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Input signal </xhtml>
              </documentation>
            </variable>
            <variable name="P">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.2" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Proportional factor </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Output signal </xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="Q1">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Previous output signal, used for feedback </xhtml>
              </documentation>
            </variable>
          </localVars>
          <tempVars>
            <variable name="P1">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Limited proportional factor </xhtml>
              </documentation>
            </variable>
          </tempVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* First, limit the proportional factor to the range [0, 1] because
values outside this range could lead to instability or unexpected
behaviour. Next, calculate the output signal using the limited
proportional factor and the internal state, i.e. the previous output
signal. The current cycle's output becomes the next cycle's feedback. *)
P1 := LIMIT(0, P, 1);
Q1 := (IN * P1) + (Q1 * (1 - P1));
Q  := Q1;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>d5328f00-ac87-46ba-aee4-c3ccbdf1a45b</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="SymmetricDebounce" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> raw input signal from a sensor or switch </xhtml>
              </documentation>
            </variable>
            <variable name="PT">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#50ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> preset time for rising and falling edge debounce </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> debounced "input" signal </xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="fbAsymmetricDebounce">
              <type>
                <derived name="AsymmetricDebounce" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fbAsymmetricDebounce(IN := IN, tPresetRise := PT, tPresetFall := PT, Q =&gt; Q);
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>b56bdd99-0441-46f5-ae39-4760b7d60f95</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="WAS" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IN">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> input signal </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> "quittierung" for change detection flag </xhtml>
              </documentation>
            </variable>
            <variable name="ET">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> elapsed time since the last change </xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="xWas">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> previous input value </xhtml>
              </documentation>
            </variable>
            <variable name="tWas">
              <type>
                <derived name="SysTimeRtc.SYSTIME" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> previous timestamp </xhtml>
              </documentation>
            </variable>
          </localVars>
          <tempVars>
            <variable name="xDif">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> difference between the current and previous input value </xhtml>
              </documentation>
            </variable>
            <variable name="tNow">
              <type>
                <derived name="SysTimeRtc.SYSTIME" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> current timestamp </xhtml>
              </documentation>
            </variable>
          </tempVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Capture the current high-resolution RTC time and determine if the
   input has changed. *)
IF SysTimeRtcHighResGet(tNow) &lt;&gt; CmpErrors.Errors.ERR_OK THEN
	RETURN;
END_IF

xDif := xWas &lt;&gt; IN;

(* Update the previous input and timestamp if a change is detected. *)
IF xDif THEN
	xWas := IN;
	tWas := tNow;
END_IF

(* Update output variables. The change detection flag (Q) and the
   elapsed time since the last change (ET). *)
Q  := xDif;
ET := ULINT_TO_TIME(tNow - tWas);
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="FB_Init" ObjectId="2870b2ba-26d9-42e1-942d-472bfd981df8">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="bInitRetains">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Indicates whether to initialise retained variables </xhtml>
                    </documentation>
                  </variable>
                  <variable name="bInCopyCode">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Indicates whether the function block is being initialised as part
	   of a copy-code operation </xhtml>
                    </documentation>
                  </variable>
                </inputVars>
                <documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.</xhtml>
                </documentation>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Get the current high-resolution RTC time. Throw away the real-time
   system's internal error code. The function block initialiser sets up
   a meaningful initial timestamp for the elapsed time calculation. *)
FB_Init := SysTimeRtcHighResGet(tWas) = CmpErrors.Errors.ERR_OK;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>74cdc3b4-d16d-49c2-8634-8cd934cf291c</ObjectId>
          </data>
        </addData>
      </pou>
