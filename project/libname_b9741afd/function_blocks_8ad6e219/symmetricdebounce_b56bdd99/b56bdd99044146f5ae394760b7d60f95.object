    "object": {
      "Graph": {
        "@Type": "6f9dac99",
        "@Value": {
          "SpecialFunc": {
            "@Type": "0db3d7bb:Enum",
            "@Value": "None"
          },
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* The raw input signal passes through the TON and TOF function blocks, which\nimplement the debounce logic. The TON block starts timing when the raw input\ngoes high, and the TOF block starts timing when the TON output goes low. The\nsystem takes the debounced output signal from the TOF output. *)\n(* Rising edge debounce *)\nfbDelayedRising(IN := xDirty, PT := tPreset);\n(* Falling edge debounce *)\nfbDelayedFalling(IN := fbDelayedRising.Q, PT := tPreset);\nxClean := fbDelayedFalling.Q;",
                  "LineInfoPersistence": "(string)b56bdd99-0441-46f5-ae39-4760b7d60f95_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)FUNCTION_BLOCK SymmetricDebounce\nVAR\n    xDirty           : BOOL;           (* raw input signal from a sensor or switch *)\n    xClean           : BOOL;           (* debounced \"input\" signal *)\n    tPreset          : TIME := T#50MS; (* preset time for debounce; default to a 20 Hertz debounce rate *)\n    fbDelayedRising  : TON;            (* timer for rising edge *)\n    fbDelayedFalling : TOF;            (* timer for falling edge *)\nEND_VAR",
                  "LineInfoPersistence": "(string)b56bdd99-0441-46f5-ae39-4760b7d60f95_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)68",
          "POULevel": {
            "@Type": "8e575c5b:Enum",
            "@Value": "Standard"
          },
          "ChildObjectGuids": {
            "@Type": "ArrayList:IList",
            "@Value": []
          },
          "AddAttributeSubsequent": "(bool)False"
        }
      },
