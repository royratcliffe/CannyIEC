    "object": {
      "Graph": {
        "@Type": "2db5746d",
        "@Value": {
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* Ring buffer zone.\n   A ring buffer contains two zones: one for putting data and one for getting\n   data. Each zone has a base, head, and tail pointer. Pointer here refers to a\n   signed zero-based index relative to the buffer's start. The base pointer\n   marks the beginning of the zone, while the head pointer marks the end of the\n   zone. The tail pointer tracks the position of the oldest data in the zone. *)\nTYPE\n    ring_buf_zone : STRUCT\n        (* Base index of the zone. Marks the starting point of the zone within the ring buffer. *)\n        base : RING_BUF_BASE;\n\n        (* Head index of the zone. Marks the end point of the zone within the ring buffer. *)\n        head : RING_BUF_BASE;\n\n        (* Tail index of the zone. Marks the position of the oldest data in the zone. *)\n        tail : RING_BUF_BASE;\n    END_STRUCT\nEND_TYPE\n",
                  "LineInfoPersistence": "(string)2ef735d8-2ebb-472b-b6ed-a22de1acffa3_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)76"
        }
      },
