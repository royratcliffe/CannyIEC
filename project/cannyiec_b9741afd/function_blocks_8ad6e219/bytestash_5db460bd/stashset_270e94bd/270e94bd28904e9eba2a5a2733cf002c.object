                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* Sets the requested bits in the stash and returns the XOR of the previous\n   stash value and the requested bits. *)\nMETHOD StashSet : BYTE\nVAR_INPUT\n\tStashing_u8: BYTE;\nEND_VAR\n",
