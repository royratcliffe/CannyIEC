    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* It does not make sense to ask for \"a\" bank, since there may be\n   multiple banks that satisfy the load condition, or none at all.\n   Instead, this method collates all banks that satisfy the load\n   condition, into the provided array, and returns the count of such\n   banks. *)\nWHILE tail <> CONS_NIL DO\n\tsetReset := LongBankLoads[tail AND CONS_MAX];\n\n\tIF (load AND setReset.Set_u32) = setReset.Set_u32 AND (load AND NOT setReset.Reset_u32) = 0 THEN\n\t\tIF bankIndex <= UPPER_BOUND(banks, 1) THEN\n\t\t\tbanks[bankIndex] := TO_SINT(LongBankLoadHeap.car(tail));\n\t\t\tbankIndex        := bankIndex + 1;\n\t\tEND_IF\n\n\t\tbankCount := bankCount + 1;\n\tEND_IF\n\n\ttail := LongBankLoadHeap.cdr(tail);\nEND_WHILE\n\nBanksForLoad := bankCount;\n",
                  "LineInfoPersistence": "(string)2e68bd90-3532-4122-ad8e-a986abc4eb45_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD BanksForLoad : DINT\nVAR_INPUT\n\tload : DWORD;\nEND_VAR\nVAR_IN_OUT\n\tbanks : ARRAY[*] OF LOAD_BANK;\nEND_VAR\nVAR\n\ttail      : CONS_REG := head;\n\tsetReset  : LongSetReset;\n\tbankIndex : DINT := LOWER_BOUND(banks, 1);\n\tbankCount : DINT := 0;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)2e68bd90-3532-4122-ad8e-a986abc4eb45_Decl_LineIds"
                }
              }
            }
          }
        }
      },
      "TypeInfos": {
        "3b83b776": "{3b83b776-fb25-43b8-99f2-3c507c9143fc}",
