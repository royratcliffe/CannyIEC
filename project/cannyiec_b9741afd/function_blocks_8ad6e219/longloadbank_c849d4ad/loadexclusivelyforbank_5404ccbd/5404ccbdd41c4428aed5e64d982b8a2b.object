    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* Load a bank that exclusively sets the specified bits. The set bits OR\n   with the stash. The reset bits AND with the stash. This presumes that\n   resets apply before sets. *)\nload.Set_u32           := set_u32;\nload.Reset_u32         := set_u32;\nLoadExclusivelyForBank := LoadForBank(bank, load);\n",
                  "LineInfoPersistence": "(string)5404ccbd-d41c-4428-aed5-e64d982b8a2b_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD LoadExclusivelyForBank : BOOL\nVAR_INPUT\n\t(* Bank to load exclusively. *)\n\tbank : LOAD_BANK;\n\t(* Bits to set exclusively. *)\n\tset_u32 : DWORD;\nEND_VAR\nVAR\n\tload : LongSetReset;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)5404ccbd-d41c-4428-aed5-e64d982b8a2b_Decl_LineIds"
                }
              }
            }
          }
        }
