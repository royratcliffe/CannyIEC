            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)Energise := FALSE;\ntail     := FindBank(bank);\n\nIF tail = CONS_NIL THEN\n\tRETURN;\nEND_IF\n\nEnergise := longStash.Stash(LongBankLoads[tail AND CONS_MAX]) <> 0;\n",
                  "LineInfoPersistence": "(string)6f30676d-24a3-44a6-a375-9e224724664e_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD Energise : BOOL\nVAR_INPUT\n\tbank : LOAD_BANK;\nEND_VAR\nVAR\n\ttail : CONS_REG;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)6f30676d-24a3-44a6-a375-9e224724664e_Decl_LineIds"
                }
              }
            }
          }
