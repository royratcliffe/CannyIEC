          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)DeEnergise := FALSE;\ntail       := FindBank(bank);\n\nIF tail = CONS_NIL THEN\n\tRETURN;\nEND_IF\n\nload           := loads[tail AND CONS_MAX];\nload.Set_u32   := NOT load.Set_u32;\nload.Reset_u32 := NOT load.Reset_u32;\nDeEnergise     := longStash.Stash(load) <> 0;\n",
                  "LineInfoPersistence": "(string)d4d8e3ae-bdfd-4b6e-b036-7a8651b6a5b3_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD DeEnergise : BOOL\nVAR_INPUT\n\tbank : LOAD_BANK;\nEND_VAR\nVAR\n\ttail : CONS_REG;\n\tload : LongSetReset;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)d4d8e3ae-bdfd-4b6e-b036-7a8651b6a5b3_Decl_LineIds"
                }
              }
            }
          }
