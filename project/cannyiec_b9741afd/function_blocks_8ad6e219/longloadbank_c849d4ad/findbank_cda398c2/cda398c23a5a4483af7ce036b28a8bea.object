    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)WHILE tail <> CONS_NIL DO\n\tIF TO_SINT(LongBankLoadHeap.car(tail)) = bank THEN\n\t\tEXIT;\n\tEND_IF\n\n\ttail := LongBankLoadHeap.cdr(tail);\nEND_WHILE\n\nFindBank := tail;\n",
                  "LineInfoPersistence": "(string)cda398c2-3a5a-4483-af7c-e036b28a8bea_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD PROTECTED FindBank : CONS_REG\nVAR_INPUT\n\tbank : LOAD_BANK;\nEND_VAR\nVAR\n\ttail : CONS_REG := head;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)cda398c2-3a5a-4483-af7c-e036b28a8bea_Decl_LineIds"
                }
              }
            }
          }
        }
      },
