                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)StashingLo_st.Set_u8   := WORD_TO_BYTE(Stashing_st.Set_u16);\nStashingLo_st.Reset_u8 := WORD_TO_BYTE(Stashing_st.Reset_u16);\nStashingHi_st.Set_u8   := WORD_TO_BYTE(SHR(Stashing_st.Set_u16, 8));\nStashingHi_st.Reset_u8 := WORD_TO_BYTE(SHR(Stashing_st.Reset_u16, 8));\nStash                  := BYTE_TO_WORD(Lo_fb.Stash(StashingLo_st)) OR SHL(BYTE_TO_WORD(Hi_fb.Stash(StashingHi_st)), 8);\n",
                  "LineInfoPersistence": "(string)3b6eb99b-b191-4b1a-9ecb-2d6f10261e8d_Impl_LineIds"
                }
