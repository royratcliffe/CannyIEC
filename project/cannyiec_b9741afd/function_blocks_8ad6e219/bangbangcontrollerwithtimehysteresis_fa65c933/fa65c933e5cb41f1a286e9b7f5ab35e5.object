    "object": {
      "Graph": {
        "@Type": "6f9dac99",
        "@Value": {
          "SpecialFunc": {
            "@Type": "0db3d7bb:Enum",
            "@Value": "None"
          },
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)IF xEnable THEN\n\txBusy    := TRUE;\n\txError   := FALSE;\n\teErrorID := 0;\n\ttonTimeToOn(IN := NOT xHysteresis, PT := tHysteresisTimeToOn);\n\ttonTimeToOff(IN := xHysteresis, PT := tHysteresisTimeToOff);\n\t{analysis -62}\n\tIF NOT xHysteresis THEN\n\t\tIF tonTimeToOn.Q AND (lrInputValue < lrSeparationValue) THEN\n\t\t\txHysteresis := TRUE;\n\t\tEND_IF;\n\tELSIF tonTimeToOff.Q AND (lrInputValue >= lrSeparationValue) THEN\n\t\txHysteresis := FALSE;\n\tEND_IF;\n\t{analysis +62}\nELSE\n\txBusy       := FALSE;\n\txError      := FALSE;\n\teErrorID    := 0;\n\txHysteresis := FALSE;\n\ttonTimeToOn(IN := FALSE, PT := T#0MS);\n\ttonTimeToOff(IN := FALSE, PT := T#0MS);\nEND_IF;\n\nxOutput := xHysteresis;\n",
                  "LineInfoPersistence": "(string)fa65c933-e5cb-41f1-a286-e9b7f5ab35e5_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)FUNCTION_BLOCK BangBangControllerWithTimeHysteresis\nVAR_INPUT\n\t/// Activates operation; FALSE aborts and resets the controller.\n\txEnable : BOOL;\n\t/// Value to classify using the separation value.\n\tlrInputValue : LREAL;\n\t/// Value separating the TRUE and FALSE input regions.\n\tlrSeparationValue : LREAL;\n\t// Minimum time before switching from FALSE to TRUE.\n\ttHysteresisTimeToOn : TIME;\n\t// Minimum time before switching from TRUE to FALSE.\n\ttHysteresisTimeToOff : TIME;\nEND_VAR\nVAR_OUTPUT\n\t/// TRUE while the enabled controller is operating.\n\txBusy : BOOL;\n\t/// Error status; this implementation has no runtime error conditions.\n\txError : BOOL;\n\t/// Hysteresis controller result.\n\txOutput : BOOL;\n\t/// Error code; zero means no error.\n\teErrorID : INT;\nEND_VAR\nVAR\n\txHysteresis  : BOOL;\n\ttonTimeToOn  : TON;\n\ttonTimeToOff : TON;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)fa65c933-e5cb-41f1-a286-e9b7f5ab35e5_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)716",
          "POULevel": {
            "@Type": "8e575c5b:Enum",
            "@Value": "Standard"
          },
