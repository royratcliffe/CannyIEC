    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)claim_size := ring_buf_zone_claim(zone := put);\n\nIF ack_size > claim_size THEN\n\tput_ack := FALSE;\nELSE\n\tput.tail := put.tail + TO_DINT(ack_size);\n\tput.head := put.tail;\n\n\tIF ring_buf_zone_tail(zone := put) >= capacity THEN\n\t\tput.base := put.base + TO_DINT(capacity);\n\tEND_IF\n\n\tput_ack := TRUE;\nEND_IF\n",
                  "LineInfoPersistence": "(string)10c0dd29-a2b1-4b2d-88d2-9fb0e5685b2f_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* Acknowledges elements claimed for putting.\n   Advances the put zone when the acknowledged amount does not exceed the\n   outstanding claim. Returns TRUE on success and FALSE otherwise. *)\nMETHOD put_ack : BOOL\nVAR_INPUT\n\tack_size : RING_BUF_SIZE;\nEND_VAR\nVAR\n\tclaim_size : RING_BUF_SIZE;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)10c0dd29-a2b1-4b2d-88d2-9fb0e5685b2f_Decl_LineIds"
                }
              }
            }
          }
        }
      },
