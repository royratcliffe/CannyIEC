    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)base := get.base;\nhead := ring_buf_zone_head(zone := get);\n\nIF head >= capacity THEN\n\tbase := base + TO_DINT(capacity);\n\thead := head - capacity;\nEND_IF\n\nring_buf_clamp(clamp_size := size, limit_size := capacity - head);\nring_buf_clamp(clamp_size := size, limit_size := used_space);\noffset    := get.head - base;\nget.head  := get.head + TO_DINT(size);\nget_claim := size;\n",
                  "LineInfoPersistence": "(string)2e907403-bcd3-4045-82cf-eaaa19953649_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(* Claims contiguous elements for getting and advances the get head.\n   The claim cannot span the end of the buffer and is limited by the\n   number of used elements. Returns the number of elements claimed and the\n   zero-based offset of the claimed space. *)\nMETHOD get_claim : RING_BUF_SIZE;\nVAR_INPUT\n\tclaim_size : RING_BUF_SIZE;\nEND_VAR\nVAR_OUTPUT\n\toffset : RING_BUF_BASE;\nEND_VAR\nVAR\n\tbase : RING_BUF_BASE;\n\thead : RING_BUF_SIZE;\n\tsize : RING_BUF_SIZE := claim_size;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)2e907403-bcd3-4045-82cf-eaaa19953649_Decl_LineIds"
                }
              }
            }
          }
        }
      },
      "TypeInfos": {
        "3b83b776": "{3b83b776-fb25-43b8-99f2-3c507c9143fc}",
