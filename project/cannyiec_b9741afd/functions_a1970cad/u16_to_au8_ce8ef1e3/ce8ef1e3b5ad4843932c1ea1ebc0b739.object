    "object": {
      "Graph": {
        "@Type": "6f9dac99",
        "@Value": {
          "SpecialFunc": {
            "@Type": "0db3d7bb:Enum",
            "@Value": "None"
          },
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)U16_TO_AU8 := FALSE;\n\nIF i32LowerBound > i32Lo THEN\n\tRETURN;\nEND_IF\n\nIF i32Lo > i32UpperBound THEN\n\tRETURN;\nEND_IF\n\nIF i32LowerBound > i32Hi THEN\n\tRETURN;\nEND_IF\n\nIF i32Hi > i32UpperBound THEN\n\tRETURN;\nEND_IF\n\nau8[i32Lo] := UINT_TO_USINT(u16);\nau8[i32Hi] := UINT_TO_USINT(SHR(u16, 8));\nU16_TO_AU8 := TRUE;\n",
                  "LineInfoPersistence": "(string)ce8ef1e3-b5ad-4843-932c-1ea1ebc0b739_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)FUNCTION U16_TO_AU8 : BOOL\nVAR_INPUT\n\t(* Where to put the low and high bytes in the array *)\n\ti32Lo, i32Hi : DINT;\n\t(* The 16-bit value to split into low and high bytes *)\n\tu16 : UINT;\nEND_VAR\nVAR_IN_OUT\n\t(* The mutable array of 8-bit values to write into *)\n\tau8 : ARRAY[*] OF USINT;\nEND_VAR\nVAR\n\ti32LowerBound : DINT := LOWER_BOUND(au8, 1);\n\ti32UpperBound : DINT := UPPER_BOUND(au8, 1);\nEND_VAR\n",
                  "LineInfoPersistence": "(string)ce8ef1e3-b5ad-4843-932c-1ea1ebc0b739_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)1229",
          "POULevel": {
            "@Type": "8e575c5b:Enum",
            "@Value": "Standard"
          },
          "ChildObjectGuids": {
            "@Type": "ArrayList:IList",
            "@Value": []
          },
          "AddAttributeSubsequent": "(bool)False"
        }
      },
