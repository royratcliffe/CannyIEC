      "STDeclaration": "FUNCTION_BLOCK FirstCycle\nVAR_OUTPUT\n\tQ : BOOL; (* TRUE during the first cycle of the program run *)\nEND_VAR\nVAR\n\tX : BOOL := FALSE; (* Has executed at least once during the program run *)\nEND_VAR\n",
      "STImplementation": "(* Track the first cycle of the program run. Q will be TRUE only during\n   the first cycle, and X will be set to TRUE afterwards. *)\nQ := NOT X;\nX := TRUE;\n"
    },
    "FLIP_FLOP": {
      "Name": "FLIP_FLOP",
      "ObjectType": "FunctionBlock",
      "Verbatim": "FUNCTION_BLOCK FLIP_FLOP",
      "Variables": [
        {
