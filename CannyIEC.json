    "AsymmetricDebounce": {
      "Name": "AsymmetricDebounce",
      "ObjectType": "FunctionBlock",
      "Verbatim": "FUNCTION_BLOCK AsymmetricDebounce",
      "Variables": [
        {
          "Name": "IN",
          "Type": {
            "Class": "BOOL"
          },
          "Comment": " raw input signal from a sensor or switch ",
          "Scope": [
            "input"
          ]
        },
        {
          "Name": "tPresetRise",
          "Type": {
            "Class": "TIME"
          },
          "Comment": " preset time for rising edge debounce ",
          "Initial": "TIME#50ms",
          "Scope": [
            "input"
          ]
        },
        {
          "Name": "tPresetFall",
          "Type": {
            "Class": "TIME"
          },
          "Comment": " preset time for falling edge debounce ",
          "Initial": "TIME#50ms",
          "Scope": [
            "input"
          ]
        },
        {
          "Name": "Q",
          "Type": {
            "Class": "BOOL"
          },
          "Comment": " debounced \"input\" signal ",
          "Scope": [
            "output"
          ]
        },
        {
          "Name": "fbDeb",
          "Type": {
            "Class": "WAS"
          },
          "Comment": " WAS instance for handling the debounce timing ",
          "Scope": [
            "local"
          ]
        }
      ],
      "STDeclaration": "FUNCTION_BLOCK AsymmetricDebounce\nVAR_INPUT\n\tIN          : BOOL;           (* raw input signal from a sensor or switch *)\n\ttPresetRise : TIME := T#50MS; (* preset time for rising edge debounce *)\n\ttPresetFall : TIME := T#50MS; (* preset time for falling edge debounce *)\nEND_VAR\nVAR_OUTPUT\n\tQ : BOOL; (* debounced \"input\" signal *)\nEND_VAR\nVAR\n\tfbDeb : WAS; (* WAS instance for handling the debounce timing *)\nEND_VAR\n",
      "STImplementation": "(* Only accept a state change after the raw input remains stable for its\n   configured debounce time. *)\nfbDeb(IN := IN);\nIF fbDeb.ET >= SEL(IN, tPresetFall, tPresetRise) THEN\n\tQ := IN;\nEND_IF;\n"
    },
    "DIF": {
