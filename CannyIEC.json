      "STDeclaration": "FUNCTION_BLOCK DIF\nVAR_INPUT\n\tIN : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tQ : BOOL;\nEND_VAR\nVAR\n\txWas : BOOL;\nEND_VAR\n",
      "STImplementation": "Q    := IN <> xWas;\nxWas := IN;\n"
    },
    "FirstCycle": {
