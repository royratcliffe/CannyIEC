            "output"
          ]
        },
        {
          "Name": "rLHS",
          "Type": {
            "Class": "REAL"
          },
          "Comment": " nominal left-hand side ",
          "Scope": [
            "input"
          ]
        },
        {
          "Name": "rRHS",
          "Type": {
            "Class": "REAL"
          },
          "Comment": " nominal right-hand side ",
          "Scope": [
            "input"
          ]
        },
        {
          "Name": "rEpsilon",
          "Type": {
            "Class": "REAL"
          },
          "Comment": " allowable difference ",
          "Initial": "REAL#1E-06",
          "Scope": [
            "input"
          ]
        }
      ],
      "STDeclaration": "FUNCTION REPSILONEQ : BOOL\nVAR_INPUT\n\trLHS     : REAL;              (* nominal left-hand side *)\n\trRHS     : REAL;              (* nominal right-hand side *)\n\trEpsilon : REAL := REAL#1e-6; (* allowable difference *)\nEND_VAR\n",
      "STImplementation": "(* Error band is inclusive of the epsilon value.\nLess than or equal to is close enough, rather than strict equality. *)\nREPSILONEQ := ABS(rLHS - rRHS) <= rEpsilon;\n"
    },
