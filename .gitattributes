
############################################################
# DO NOT EDIT THIS FILE - the content may be overwritten
# Version: 1.0.0.0
############################################################



# Do not try to merge files when they have conflicts, but rather use our
# side of the merge over others.
* merge=ours

# treat these files as binaries
*.meta -text -diff

# .object files are pretty-printed JSON (see scripts/pre-commit);
# allow diff'ing and do not skip line-ending normalisation since the
# hook writes LF consistently.
*.object text eol=lf

# Treat PDF files as binaries
*.pdf -text
